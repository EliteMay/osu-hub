{
  "name": "osu-setup-launcher",
  "version": "0.18.3",
  "description": "osu!lazer 用の一括セットアップ起動Electronアプリ",
  "main": "src/bootstrap.js",
  "scripts": {
    "start": "electron .",
    "start:safe": "electron .",
    "build:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "local.osu.setup.launcher",
    "productName": "osu Setup Launcher",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "EliteMay",
        "repo": "osu-hub"
      }
    ],
    "files": [
      "src/**/*",
      "data/**/*",
      "tools/**/*",
      "!tools/*.exe",
      "!tools/*.zip",
      "!tools/*.chm",
      "!tools/_nircmd_download/**/*",
      "!tools/nircmd_package/**/*",
      "!tools/NirCmd_source_notice.txt",
      "package.json",
      "README.md",
      "作業報告書.md"
    ],
    "win": {
      "target": [{"target":"nsis","arch":["x64"]}],
      "artifactName": "osu_setup_${version}_setup.${ext}",
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "osu Setup Launcher"
    },
    "artifactName": "osu_setup_${version}_setup.${ext}"
  },
  "author": "EliteMay"
}
